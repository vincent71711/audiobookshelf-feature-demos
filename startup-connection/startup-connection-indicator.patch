diff --git a/tests/startupConnection.test.cjs b/tests/startupConnection.test.cjs
new file mode 100644
index 00000000..7fb1a84c
--- /dev/null
+++ b/tests/startupConnection.test.cjs
@@ -0,0 +1,72 @@
+const { test } = require('node:test')
+const assert = require('node:assert/strict')
+const fs = require('node:fs')
+const vm = require('node:vm')
+function setup() {
+  const context = { module: { exports: {} }, Date: { now: () => 1000 } }
+  const source = fs.readFileSync('store/index.js', 'utf8').replace(/^import .*$/gm, '').replace(/export const /g, 'const ')
+  vm.runInNewContext(source + '\nmodule.exports = {state, mutations}', context)
+  const { state, mutations } = context.module.exports
+  const page = fs.readFileSync('pages/bookshelf/index.vue', 'utf8').split('<script>')[1].split('</script>')[0]
+  vm.runInNewContext(page.replace('export default', 'module.exports ='), context)
+  return { state: state(), mutations, show: context.module.exports.computed.showStartupConnection, page: context.module.exports }
+}
+test('cold launch grace expires after five seconds, including when page is revisited', () => {
+  const { state, show } = setup()
+  assert.equal(show.call({ startupNow: 1000, $store: { state } }), true)
+  assert.equal(show.call({ startupNow: 5999, $store: { state } }), true)
+  assert.equal(show.call({ startupNow: 6000, $store: { state } }), false)
+  assert.equal(show.call({ startupNow: 9000, $store: { state } }), false)
+})
+test('no saved server immediately ends startup grace', () => {
+  const { state, mutations } = setup()
+  mutations.setDeviceData(state, { serverConnectionConfigs: [] })
+  assert.equal(state.startupConnectionDeadline, 0)
+})
+test('saved server retains grace until data arrives, then clears immediately', () => {
+  const { state, mutations, show } = setup()
+  mutations.setDeviceData(state, { lastServerConnectionConfigId: 'server', serverConnectionConfigs: [{ id: 'server' }] })
+  assert.equal(state.startupConnectionDeadline, 6000)
+  mutations.finishStartupConnection(state)
+  assert.equal(show.call({ startupNow: 1200, $store: { state } }), false)
+})
+test('a missing previously selected server does not delay setup', () => {
+  const { state, mutations } = setup()
+  mutations.setDeviceData(state, { lastServerConnectionConfigId: 'old', serverConnectionConfigs: [{ id: 'other' }] })
+  assert.equal(state.startupConnectionDeadline, 0)
+})
+
+for (const [label, response] of [['empty', []], ['populated', [{ type: 'book', entities: [] }]]]) {
+  test(`a successful ${label} bookshelf response ends the startup grace`, async () => {
+    const { state, mutations, page } = setup()
+    const instance = {
+      ...page.data(),
+      user: {}, currentLibraryId: 'demo', networkConnected: true,
+      $db: { getLocalLibraryItems: async () => [] },
+      getLocalMediaItemCategories: () => [],
+      $nativeHttp: { get: async () => response },
+      $store: { commit: (name) => mutations[name](state) }
+    }
+    await page.methods.fetchCategories.call(instance)
+    assert.equal(state.startupConnectionDeadline, 0)
+    assert.equal(instance.isLoading, false)
+    assert.equal(instance.shelves.length, response.length)
+  })
+}
+
+test('a failed request preserves downloaded shelves and does not masquerade as a successful empty response', async () => {
+  const { state, mutations, page } = setup()
+  const downloaded = [{ type: 'book', entities: [{ id: 'local-book' }] }]
+  const instance = {
+    ...page.data(),
+    user: {}, currentLibraryId: 'demo', networkConnected: true,
+    $db: { getLocalLibraryItems: async () => [] },
+    getLocalMediaItemCategories: () => downloaded,
+    $nativeHttp: { get: async () => { throw new Error('offline') } },
+    $store: { commit: (name) => mutations[name](state) }
+  }
+  await page.methods.fetchCategories.call(instance)
+  assert.equal(state.startupConnectionDeadline, 6000)
+  assert.equal(instance.isLoading, false)
+  assert.equal(instance.shelves, downloaded)
+})
